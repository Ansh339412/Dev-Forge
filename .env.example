# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (use URL-safe characters in the password; it is embedded in DATABASE_URL)
POSTGRES_USER=devforge
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=devforge
# Used when running the backend outside Docker. docker-compose overrides this.
DATABASE_URL=postgresql://devforge:replace-with-a-url-safe-password@localhost:5432/devforge?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# Frontend origin(s), comma-separated, and the base URL used in email links
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Mail (local default: MailHog UI at http://localhost:8025)
# For Brevo SMTP, use smtp-relay.brevo.com:587, your Brevo SMTP login/key,
# and a sender address verified with Brevo. Keep these credentials only in .env.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DevForge <no-reply@devforge.local>

# File attachments (S3-compatible). Locally, docker-compose runs SeaweedFS with these credentials;
# generate values with: openssl rand -hex 16
S3_BUCKET=devforge-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-secret-key
# Used by the backend (docker-compose overrides this to http://s3:8333)
S3_ENDPOINT=http://localhost:8333
# Address your browser can reach, used in download links
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
# Local dev only: create the bucket on startup. On AWS, create it yourself and leave this false.
S3_CREATE_BUCKET=true

# Optional integrations
# Resend HTTP email API. If set it is used instead of SMTP (MAIL_FROM must be a verified sender).
RESEND_API_KEY=
# GitHub token (optional): raises the API rate limit above 60/h and allows private repos it can see.
GITHUB_TOKEN=

# Reverse proxies in front of the API (used for client IPs in rate limiting)
TRUST_PROXY_HOPS=1

# Swagger UI at /api/docs (always on outside production)
ENABLE_SWAGGER=true

# Optional monitoring stack (docker compose --profile monitoring up): Grafana admin password
GRAFANA_ADMIN_PASSWORD=
