# Production settings for docker-compose.prod.yml. scripts/setup-prod-env.sh creates .env.prod from this
# with random secrets; you fill in the storage and email values. Never commit .env.prod.
DOMAIN=devforge.example.com
NODE_ENV=production
LOG_LEVEL=info
ENABLE_SWAGGER=false
# Caddy + nginx sit in front of the backend
TRUST_PROXY_HOPS=2

POSTGRES_USER=devforge
POSTGRES_PASSWORD=
POSTGRES_DB=devforge
JWT_ACCESS_SECRET=

APP_URL=https://devforge.example.com
CORS_ORIGIN=https://devforge.example.com

# Email through Resend (API key) or Brevo (SMTP credentials). Verify your sender/domain.
MAIL_FROM=DevForge <no-reply@devforge.example.com>
RESEND_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3, ...). Keep the bucket private.
S3_BUCKET=
S3_REGION=auto
# Leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT empty for AWS S3; set both to your provider's endpoint otherwise.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_CREATE_BUCKET=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: raises the GitHub API rate limit
GITHUB_TOKEN=
